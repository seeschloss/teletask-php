{
    "name": "seeschloss/teletask-php",
    "description": "Dependency-free PHP client for the local TELETASK iSGUI/GUI protocol",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*"
    },
    "autoload": {
        "psr-4": {
            "Teletask\\": "src/Teletask/"
        }
    },
    "bin": [
        "bin/teletask"
    ]
}
